# 3D Business Manager - Environment Variables Configuration

# 1. Base de Datos Local (SQLite por defecto para ejecución inmediata sin dependencias externas)
DATABASE_URL="file:./dev.db"

# 2. Base de Datos en la Nube (Opcional - PostgreSQL / Supabase)
# Para conectar a Supabase o PostgreSQL en la nube, cambia el provider en prisma/schema.prisma a "postgresql" y descomenta:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# 3. Almacenamiento de Fotografías (Opcional - Supabase Storage)
# Por defecto las fotos se almacenan directamente en Base64 / URLs en la base de datos para funcionar 100% offline.
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_STORAGE_BUCKET="product-photos"

# 4. Entorno de Ejecución
NODE_ENV="development"
PORT=3000
